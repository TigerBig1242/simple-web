---
// src/pages/about.astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header     from "@/components/Header.astro";
import CartButton from "@/components/CartButton";
import CartPanel  from "@/components/CartPanel";
---

<BaseLayout
  title="About — Atelier Brew"
  description="The story behind Atelier Brew specialty café."
>
  <Header />
  <!-- <CartButton client:load /> -->
  <CartPanel  client:load />

  <main class="max-w-[760px] mx-auto px-6 py-16 pb-24">

    <span class="font-sans text-[11px] text-brew-muted uppercase tracking-[0.12em]">
      Our Story
    </span>

    <h1 class="font-serif text-[48px] font-semibold text-brew-espresso leading-[1.1] mt-3 mb-6">
      Crafted for the<br />
      <em class="not-italic text-brew-accent-lt">curious palate.</em>
    </h1>

    <div class="h-px bg-brew-border mb-8" />

    <div class="font-sans text-[15px] text-brew-muted font-light leading-[1.9] space-y-5">
      <p>
        Atelier Brew was born from a simple belief: that a great cup of tea or
        coffee is a small act of daily luxury available to everyone. We source our
        beans and leaves directly from smallholder farms across Ethiopia, Japan,
        Taiwan, and Colombia — relationships built on transparency and fair pay.
      </p>
      <p>
        Every drink on our menu is developed in-house by our beverage team, who
        spend weeks dialing in ratios, temperatures, and pairings before a single
        cup reaches you. Nothing is accidental; everything is intentional.
      </p>
      <p>
        We believe the café should feel like a third place — somewhere between
        home and work — where time slows, the air smells of roasted goodness, and
        the right drink can genuinely shift your mood. That's what we're building,
        one order at a time.
      </p>
    </div>

    <div class="mt-10">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-sans text-[13px] font-medium
               text-brew-espresso border border-brew-border rounded-xl
               px-5 py-3 hover:bg-brew-cream transition-colors duration-150
               no-underline"
      >
        ← Back to the menu
      </a>
    </div>

  </main>
</BaseLayout>
